rules_version = '2';

// Notely security rules. Each person can only reach their own data under
// users/{uid}. Fields that grant purchases are written only by Cloud
// Functions (which bypass these rules), never by the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields only the server may set.
    function touchesServerFields() {
      let changed = resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['entitlements']);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && !touchesServerFields()
        && (!('activeSkinId' in request.resource.data)
            || (request.resource.data.activeSkinId is string
                && request.resource.data.activeSkinId.size() <= 64))
        && (!('appearance' in request.resource.data)
            || request.resource.data.appearance in ['system', 'light', 'dark']);

      // Notebooks, pages, tasks, events... (added in later phases).
      // `{collection}` makes this match only data below the user doc. A bare
      // `{document=**}` would also match users/{uid} itself (it can match an
      // empty path) and bypass the field checks above.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Public skin catalog, managed from the Firebase console.
    match /skins/{skinId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Everything else is closed.
  }
}
