rules_version = '2';

// Notely Cloud Storage rules. Each person can only reach their own files
// under users/{uid}: cover photos and photos on pages, images under 5 MB.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{folder}/{file} {
      allow read, delete: if isOwner(uid) && folder in ['covers', 'images'];
      allow create, update: if isOwner(uid)
        && folder in ['covers', 'images']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Catalog files, published with tool/catalog.py. Previews are open to
    // anyone signed in; a pack only to people who may use the item.
    match /catalog/{itemId}/{version}/preview.webp {
      allow read: if request.auth != null;
    }

    match /catalog/{itemId}/{version}/pack.zip {
      allow read: if request.auth != null && canUseItem(itemId);
    }

    // Same rules as Entitlements.canUseCatalogItem in the app. Repeated
    // lookups within one request are fetched (and billed) once.
    function canUseItem(itemId) {
      return unlockOf(itemId).get('free', false) == true
        || (unlockOf(itemId).get('pro', false) == true
            && purchases().get('pro', false) == true)
        || purchases().get('products', []).hasAny(
            unlockOf(itemId).get('products', []))
        || purchases().get('grants', []).hasAny([itemId]);
    }

    function unlockOf(itemId) {
      return firestore.get(
          /databases/(default)/documents/catalog/$(itemId)).data.unlock;
    }

    function purchases() {
      return firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid))
          .data.get('entitlements', {});
    }

    // Everything else is closed.
  }
}
